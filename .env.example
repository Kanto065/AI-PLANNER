# --- Docker Compose (postgres + caddy) ---
POSTGRES_USER="planner"
POSTGRES_PASSWORD="planner"
POSTGRES_DB="planner"
# Domain Caddy requests a cert for. Leave as "localhost" for local dev;
# set to kanto-planner.duckdns.org on the VPS.
SITE_ADDRESS="localhost"

# Only used by docker-compose.yml (the shared-VPS variant): the docker
# network name of the VPS's existing reverse-proxy stack that "web" should
# join, so that Caddy can reach it by container name. See DEPLOY.md.
PROXY_NETWORK="platform_internal"

# --- Database ---
# Used directly by `next dev` on the host, and by docker-compose's web
# service to build DATABASE_URL from the POSTGRES_* vars above.
DATABASE_URL="postgresql://planner:planner@localhost:5432/planner?schema=public"

# --- Auth.js ---
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Optional Google sign-in (leave blank to keep credentials-only login)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Seed / admin account ---
# Used only by `prisma/seed.ts` to create the single user account.
# CHANGE THESE before deploying anywhere reachable from the internet.
ADMIN_EMAIL="admin@kanto-planner.local"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin"

# --- AI providers (server-side only, never exposed to the client) ---
GROQ_API_KEY=""
GEMINI_API_KEY=""
